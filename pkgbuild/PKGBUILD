# Maintainer: RolandDumit
# Local checkout package. See ../docs/packaging.md before publishing on AUR.

pkgname=omascribe
pkgver=0.7.0
pkgrel=1
pkgdesc='Omascribe Markdown editor for Omarchy, based on Omawrite'
arch=('x86_64')
url='https://github.com/RolandDumit/omascribe'
license=('MIT' 'OFL-1.1')
options=('!debug')
install='omascribe.install'
depends=('hicolor-icon-theme' 'qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/omascribe "$pkgdir/usr/bin/omascribe"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 "$startdir/omascribe.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/omascribe.svg"
  /usr/bin/install -Dm644 "$startdir/omascribe.desktop" "$pkgdir/usr/share/applications/omascribe.desktop"
}
