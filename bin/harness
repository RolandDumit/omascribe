#!/usr/bin/env python3
"""Local, isolated verification and interactive profiles for Omascribe."""

from __future__ import annotations

import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import signal
import struct
import subprocess
import sys
import tarfile
import time
import uuid
import xml.etree.ElementTree as ET


ROOT = Path(__file__).resolve().parent.parent
HARNESS = ROOT / ".harness"
BINARY = ROOT / "build" / "omascribe"
SCREENSHOT_SCENARIOS = ("dark", "light", "minimum-scale", "search", "unsaved", "external")
QML_DIAGNOSTIC = re.compile(
    r"Binding loop detected|ReferenceError:|TypeError:|"
    r"(?:qrc:/|file:///).*\bQML\b|QQmlApplicationEngine failed|"
    r"QQmlComponent: Component is not ready"
)


def release_metadata() -> dict:
    application = (ROOT / "src" / "appversion.h").read_text(encoding="utf-8")
    package = (ROOT / "pkgbuild" / "PKGBUILD").read_text(encoding="utf-8")
    app_version = re.search(r'version\[\]\s*=\s*"(\d+\.\d+\.\d+)"', application)
    pkg_version = re.search(r"^pkgver=(\d+\.\d+\.\d+)$", package, re.MULTILINE)
    pkg_release = re.search(r"^pkgrel=([1-9]\d*)$", package, re.MULTILINE)
    if not app_version or not pkg_version or not pkg_release:
        raise RuntimeError("Application and package need explicit stable versions and a positive pkgrel.")
    version = app_version.group(1)
    if version != pkg_version.group(1):
        raise RuntimeError(f"Application {version} and PKGBUILD {pkg_version.group(1)} disagree; update both before release.")
    if f"**{version}**" not in (ROOT / "README.md").read_text(encoding="utf-8"):
        raise RuntimeError(f"README must identify the current release as **{version}**.")
    return {"version": version, "pkgrel": pkg_release.group(1), "tag": f"v{version}"}


def prepare_aur(args: argparse.Namespace) -> int:
    """Prepare publishable files locally from the published tag's source archive."""
    metadata = release_metadata()
    version = metadata["version"]
    archive = Path(args.archive).expanduser().resolve()
    package = (ROOT / "pkgbuild" / "PKGBUILD").read_text(encoding="utf-8")
    marker = "source=()\nsha256sums=()"
    if marker not in package:
        raise RuntimeError("The local PKGBUILD must declare empty source and checksum arrays.")
    header = package.split(marker, 1)[0].replace(
        "# Local checkout package. See ../docs/packaging.md before publishing on AUR.",
        "# Published release package generated by bin/harness prepare-aur.",
    )
    with archive.open("rb") as source:
        checksum = hashlib.sha256()
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            checksum.update(chunk)
        digest = checksum.hexdigest()
    prefix = f"omascribe-{version}/"
    with tarfile.open(archive, "r:gz") as source:
        def read_member(name: str) -> bytes:
            try:
                member = source.getmember(prefix + name)
            except KeyError as error:
                raise RuntimeError(f"Release archive is missing {name}.") from error
            if not member.isfile() or member.size > 1024 * 1024:
                raise RuntimeError(f"Invalid release archive member: {name}.")
            with source.extractfile(member) as contents:
                return contents.read()

        if read_member("src/appversion.h").decode("utf-8") != (ROOT / "src/appversion.h").read_text(encoding="utf-8"):
            raise RuntimeError("The archive's application version differs from the checkout.")
        archived_package = read_member("pkgbuild/PKGBUILD").decode("utf-8")
        archived_version = re.search(r"^pkgver=(\d+\.\d+\.\d+)$", archived_package, re.MULTILINE)
        archived_release = re.search(r"^pkgrel=([1-9]\d*)$", archived_package, re.MULTILINE)
        if not archived_version or archived_version.group(1) != version or not archived_release:
            raise RuntimeError("The archive's package version differs from the checkout.")
        release_number = int(metadata["pkgrel"])
        archived_release_number = int(archived_release.group(1))
        if release_number < archived_release_number:
            raise RuntimeError("The checkout's pkgrel is older than the published archive.")
        if release_number == archived_release_number and archived_package != package:
            raise RuntimeError("Packaging changes to a published version require a pkgrel bump.")
        install_script = read_member("pkgbuild/omascribe.install")
        current_install_script = (ROOT / "pkgbuild" / "omascribe.install").read_bytes()
        if current_install_script != install_script:
            if release_number == archived_release_number:
                raise RuntimeError("Install script changes to a published version require a pkgrel bump.")
            install_script = current_install_script
    if not shutil.which("makepkg"):
        raise RuntimeError("makepkg is required to generate the AUR .SRCINFO.")
    directory = new_directory(HARNESS / "releases")
    aur = directory / "aur"
    aur.mkdir(mode=0o700)
    recipe = header + f'''source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('{digest}')

build() {{
  cd "$srcdir/$pkgname-$pkgver"
  ./bin/build
}}

package() {{
  cd "$srcdir/$pkgname-$pkgver"
  /usr/bin/install -Dm755 build/omascribe "$pkgdir/usr/bin/omascribe"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  /usr/bin/install -Dm644 pkgbuild/omascribe.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/omascribe.svg"
  /usr/bin/install -Dm644 pkgbuild/omascribe.desktop "$pkgdir/usr/share/applications/omascribe.desktop"
}}
'''
    (aur / "PKGBUILD").write_text(recipe, encoding="utf-8")
    (aur / "omascribe.install").write_bytes(install_script)
    srcinfo = subprocess.run(["makepkg", "--printsrcinfo"], cwd=aur,
                             capture_output=True, text=True, check=True, timeout=30)
    (aur / ".SRCINFO").write_text(srcinfo.stdout, encoding="utf-8")
    shutil.copyfile(archive, aur / f"omascribe-{version}.tar.gz")
    report = {"schemaVersion": 1, "status": "prepared", **metadata,
              "sourceArchive": str(archive), "sha256": digest, "aurDirectory": str(aur),
              "publishFiles": ["PKGBUILD", ".SRCINFO", "omascribe.install"],
              "aurPublished": False}
    (directory / "report.json").write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    print(f"AUR files: {aur}")
    print("Verify with makepkg -f, then commit only PKGBUILD, .SRCINFO and omascribe.install to AUR.")
    return 0


def new_directory(parent: Path) -> Path:
    name = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")
    directory = parent / f"{name}-{uuid.uuid4().hex[:10]}"
    directory.mkdir(parents=True, mode=0o700)
    return directory


@contextmanager
def build_lock():
    """Shared qmake output directories cannot be built concurrently."""
    HARNESS.mkdir(exist_ok=True, mode=0o700)
    with (HARNESS / "build.lock").open("a") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def prerequisite_details() -> dict:
    qmake = shutil.which("qmake6") or shutil.which("qmake")
    if not qmake:
        raise RuntimeError("Qt 6 qmake is required (qmake6 or qmake).")
    try:
        version = subprocess.run(
            [qmake, "-query", "QT_VERSION"], check=True,
            text=True, capture_output=True, timeout=10,
        ).stdout.strip()
    except (subprocess.SubprocessError, OSError) as error:
        raise RuntimeError(f"Could not query qmake: {error}") from error
    if not version.startswith("6."):
        raise RuntimeError(f"Qt 6 is required; {qmake} reports Qt {version}.")
    make = shutil.which("make")
    compiler = shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")
    if not make or not compiler:
        raise RuntimeError("make and a C++17 compiler are required.")
    return {
        "python": sys.version.split()[0], "qmake": qmake,
        "qt": version, "make": make, "compiler": compiler,
    }


def execute(command: list[str], log: Path, env: dict[str, str], timeout: float) -> dict:
    started = time.monotonic()
    result = {"command": command, "log": str(log), "status": "failed"}
    with log.open("w", encoding="utf-8") as output:
        process = subprocess.Popen(
            command, cwd=ROOT, env=env, stdout=output,
            stderr=subprocess.STDOUT, start_new_session=True,
        )
        try:
            result["exitCode"] = process.wait(timeout=timeout)
            result["status"] = "passed" if result["exitCode"] == 0 else "failed"
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait()
            result["error"] = f"Timed out after {timeout:g} seconds."
        except BaseException:
            if process.poll() is None:
                os.killpg(process.pid, signal.SIGKILL)
                process.wait()
            raise
    result["durationSeconds"] = round(time.monotonic() - started, 3)
    return result


def isolated_environment(directory: Path) -> dict[str, str]:
    env = os.environ.copy()
    profile = directory / "profile"
    runtime = directory / "runtime"
    runtime.mkdir(mode=0o700)
    for name in ("config", "data", "cache", "documents"):
        (profile / name).mkdir(parents=True, mode=0o700)
    env.update({
        "QT_QPA_PLATFORM": "offscreen",
        "QT_QUICK_BACKEND": "software",
        "QT_SCALE_FACTOR": "1",
        "QT_SCREEN_SCALE_FACTORS": "1",
        "QT_AUTO_SCREEN_SCALE_FACTOR": "0",
        "QT_ENABLE_HIGHDPI_SCALING": "0",
        "XDG_RUNTIME_DIR": str(runtime),
        "XDG_CONFIG_HOME": str(profile / "config"),
        "XDG_DATA_HOME": str(profile / "data"),
        "XDG_CACHE_HOME": str(profile / "cache"),
        "OMASCRIBE_PROFILE_THEME": "dark",
        "OMASCRIBE_PROFILE_SCALE": "1",
        "OMASCRIBE_TEST_ARTIFACT_DIR": str(directory / "artifacts"),
        "OMASCRIBE_BINARY": str(BINARY),
    })
    # A developer's Qt style or platform override must not change these checks.
    env.pop("QT_QUICK_CONTROLS_STYLE", None)
    env.pop("QT_QUICK_CONTROLS_MATERIAL_THEME", None)
    env.pop("QT_FONT_DPI", None)
    return env


def inspect_results(directory: Path) -> dict:
    errors = []
    results_path = directory / "results.xml"
    counts = {"tests": 0, "failures": 0, "errors": 0, "skipped": 0}
    try:
        root = ET.parse(results_path).getroot()
        counts["tests"] = len(root.findall(".//testcase"))
        for category in ("failure", "error", "skipped"):
            key = "failures" if category == "failure" else category + ("s" if category == "error" else "")
            counts[key] = len(root.findall(f".//{category}"))
        if not counts["tests"]:
            errors.append("QtTest produced no test cases.")
        if counts["failures"] or counts["errors"]:
            errors.append("QtTest reported failures or errors.")
    except (OSError, ET.ParseError) as error:
        errors.append(f"Missing or invalid QtTest XML: {error}")

    warnings = []
    for line in (directory / "tests.log").read_text(encoding="utf-8", errors="replace").splitlines():
        if QML_DIAGNOSTIC.search(line):
            warnings.append(line)
    if warnings:
        errors.append("Unexpected QML diagnostics were found in the test log.")

    artifacts = []
    artifact_directory = directory / "artifacts"
    screenshots = sorted(artifact_directory.rglob("*.png"))
    missing = set(SCREENSHOT_SCENARIOS) - {path.stem for path in screenshots}
    if missing:
        errors.append("Required screenshots are missing: " + ", ".join(sorted(missing)))
    for screenshot in screenshots:
        state_path = screenshot.with_suffix(".json")
        entry = {"screenshot": str(screenshot), "state": str(state_path)}
        try:
            with screenshot.open("rb") as source:
                header = source.read(24)
                if len(header) != 24 or header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
                    raise ValueError("Invalid PNG header")
                width, height = struct.unpack(">II", header[16:24])
                if width == 0 or height == 0:
                    raise ValueError("Empty PNG image")
                entry.update({"width": width, "height": height})
            with state_path.open(encoding="utf-8") as source:
                state = json.load(source)
                if not isinstance(state, dict):
                    raise ValueError("State must be a JSON object")
                capture = state.get("capture", {})
                if not isinstance(capture, dict) or capture.get("version") != state.get("version"):
                    raise ValueError("Capture and document versions differ")
                if capture.get("width") != width or capture.get("height") != height:
                    raise ValueError("Capture dimensions differ from the PNG")
        except (OSError, ValueError) as error:
            errors.append(f"Invalid screenshot/state pair {screenshot.name}: {error}")
        artifacts.append(entry)
    return {
        "status": "failed" if errors else "passed", "testCounts": counts,
        "qmlDiagnostics": warnings, "artifacts": artifacts, "errors": errors,
    }


def check(args: argparse.Namespace) -> int:
    directory = new_directory(HARNESS / "runs")
    (directory / "artifacts").mkdir()
    report = {
        "schemaVersion": 1, "status": "failed", "directory": str(directory),
        "startedAt": datetime.now(timezone.utc).isoformat(), "stages": [],
    }
    print(f"Verification artifacts: {directory}", flush=True)
    exit_code = 1
    try:
        report["stages"].append({"name": "version", "status": "passed", **release_metadata()})
        report["prerequisites"] = prerequisite_details()
        env = isolated_environment(directory)
        print("Checking release metadata and standalone packaging safeguards…", flush=True)
        release_tests = execute(
            [sys.executable, "-B", str(ROOT / "tests" / "test_harness_release.py")],
            directory / "release-tests.log", env, 60,
        )
        report["stages"].append({"name": "release-tests", **release_tests})
        if release_tests["status"] != "passed":
            raise RuntimeError("Release checks failed; inspect release-tests.log.")
        waiting = time.monotonic()
        with build_lock():
            report["buildLockWaitSeconds"] = round(time.monotonic() - waiting, 3)
            print("Building application…", flush=True)
            build = execute([str(ROOT / "bin" / "build")], directory / "build.log", env, 600)
            report["stages"].append({"name": "build", **build})
            if build["status"] != "passed":
                raise RuntimeError("Application build failed; inspect build.log.")
            print("Running document, interface and process checks…", flush=True)
            test = execute(
                [str(ROOT / "bin" / "test"), "-o", f"{directory / 'results.xml'},junitxml", "-o", "-,txt"],
                directory / "tests.log", env, args.timeout,
            )
            report["stages"].append({"name": "tests", **test})
        evidence = inspect_results(directory)
        report["evidence"] = evidence
        if test["status"] != "passed" or evidence["status"] != "passed":
            raise RuntimeError("Verification failed; inspect tests.log, results.xml and report.json.")
        report["status"] = "passed"
        exit_code = 0
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        report["error"] = str(error)
        print(str(error), file=sys.stderr)
    except KeyboardInterrupt:
        report["error"] = "Verification interrupted."
        exit_code = 130
    finally:
        report["finishedAt"] = datetime.now(timezone.utc).isoformat()
        with (directory / "report.json").open("w", encoding="utf-8") as output:
            json.dump(report, output, ensure_ascii=False, indent=2)
            output.write("\n")
        print(f"{report['status'].capitalize()}: {directory / 'report.json'}", flush=True)
    return exit_code


def run(args: argparse.Namespace) -> int:
    prerequisite_details()
    profile = Path(args.profile).expanduser().resolve() if args.profile else new_directory(HARNESS / "profiles")
    profile.mkdir(parents=True, exist_ok=True, mode=0o700)
    env = os.environ.copy()
    if args.theme:
        env["OMASCRIBE_PROFILE_THEME"] = args.theme
    else:
        env.pop("OMASCRIBE_PROFILE_THEME", None)
    env["OMASCRIBE_PROFILE_SCALE"] = str(args.scale)
    if args.headless:
        env.update({"QT_QPA_PLATFORM": "offscreen", "QT_QUICK_BACKEND": "software"})
    if not BINARY.exists() or args.build:
        with build_lock():
            subprocess.run([str(ROOT / "bin" / "build")], cwd=ROOT, env=env, check=True)
    command = [str(BINARY), "--profile", str(profile)]
    if args.file:
        command.append(str(Path(args.file).expanduser().resolve()))
    print(f"Isolated profile: {profile}", flush=True)
    # The application inherits the terminal and owns the interactive lifetime.
    return subprocess.call(command, cwd=ROOT, env=env)


def positive_number(value: str) -> float:
    try:
        number = float(value)
    except ValueError as error:
        raise argparse.ArgumentTypeError("Expected a positive number.") from error
    if not math.isfinite(number) or number <= 0:
        raise argparse.ArgumentTypeError("Expected a finite positive number.")
    return number


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    check_parser = commands.add_parser("check", help="Build and verify in an isolated run; preserve all evidence.")
    check_parser.add_argument("--timeout", type=positive_number, default=300, help="Test timeout in seconds (default: 300).")
    run_parser = commands.add_parser("run", help="Open an isolated profile; print its location for reuse.")
    run_parser.add_argument("file", nargs="?", help="Markdown file to open.")
    run_parser.add_argument("--profile", help="Existing or new profile directory.")
    run_parser.add_argument("--theme", choices=("dark", "light"), help="Set a deterministic profile palette (default: preserve existing, dark for new).")
    run_parser.add_argument("--scale", type=positive_number, default=1, help="Text scale (default: 1; use 1.333333333 for 4/3).")
    run_parser.add_argument("--headless", action="store_true", help="Use the offscreen software renderer for control experiments.")
    run_parser.add_argument("--build", action="store_true", help="Rebuild even if the application already exists.")
    aur_parser = commands.add_parser("prepare-aur", help="Prepare AUR files from the published release source archive.")
    aur_parser.add_argument("--archive", required=True, help="Downloaded GitHub tag archive; must match this checkout's version (packaging fixes require a pkgrel bump).")
    args = parser.parse_args()
    try:
        if args.command == "check":
            return check(args)
        if args.command == "prepare-aur":
            return prepare_aur(args)
        return run(args)
    except (OSError, RuntimeError, subprocess.SubprocessError, tarfile.TarError, UnicodeError) as error:
        print(str(error), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
